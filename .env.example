# ==============================================================================
# VETMIND PLATFORM - ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NETLIFY SERVERLESS FUNCTIONS ENVIRONMENT VARIABLES (PRIVATE - SECRETS)
# Configurar no painel Netlify: Site Configuration > Environment Variables
# NEVER prefix private secrets with VITE_ to keep them hidden from frontend JS
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSy...SuaChavePrivadaDoGoogleAIStudio...

# ------------------------------------------------------------------------------
# 2. FIREBASE PUBLIC CLIENT CONFIGURATION (PUBLIC - EMBEDDED IN FRONTEND)
# Safe to expose in frontend - Protected by Firebase Security Rules & App Check
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=AIzaSy...SuaChavePublicaFirebase...
VITE_FIREBASE_AUTH_DOMAIN=vetmind-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=vetmind-app
VITE_FIREBASE_STORAGE_BUCKET=vetmind-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1029384756
VITE_FIREBASE_APP_ID=1:1029384756:web:abcd1234efgh5678
VITE_FIREBASE_APPCHECK_KEY=6L...SuaSiteKeyReCAPTCHAv3...

# ------------------------------------------------------------------------------
# 3. OPTIONAL LOCAL DEV GEMINI KEY (Only if running without Netlify Dev CLI)
# ------------------------------------------------------------------------------
# VITE_GEMINI_API_KEY=AIzaSy...ChaveOpcionalApenasParaDevLocal...
